# ===========================================================================
# IBPM CR AUTOMATION SYSTEM - CONFIGURAÇÕES DE AMBIENTE (.env.example)
# ===========================================================================

# ⚡ Chave da API do Groq (Fase 2 Mineração - Modelos Open-Source 100% Gratuitos na Nuvem)
# Obtenha sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=SUA_CHAVE_GROQ_AQUI
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# 📺 Configurações do YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCHhLxWRcCB-xKo0ifOQ8MVQ
YOUTUBE_CHANNEL_HANDLE=@ibpmcr7976

# 🎙️ Configurações do Faster-Whisper CPU (Fase 2 Transcrição)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ☁️ Integração com Google Drive Local / Nuvem
DRIVE_MOUNT_PATH=G:\Meu Drive\IBPM_CR_Cortes
